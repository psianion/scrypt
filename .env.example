# Scrypt — environment configuration
# Copy to .env and fill in — OR just run `scrypt init`, which generates a strong
# token automatically, writes the right keys for your chosen profile (native /
# docker / vps), and never clobbers values you've already set.

# Required in production (and whenever SCRYPT_BIND_ADDR is non-loopback).
# Single shared bearer token gating all remote /api/* and /mcp calls.
# `scrypt init` auto-generates this. Manual: openssl rand -hex 32
SCRYPT_AUTH_TOKEN=change-me

# Optional — defaults shown
# SCRYPT_PORT=3777
# SCRYPT_VAULT_PATH=/vault
# SCRYPT_LOG_LEVEL=info
# SCRYPT_TRASH_RETENTION_DAYS=30

# --- Vault sync -------------------------------------------------------------
# Hub URL the IN-APP SyncBar / clash-resolver talk to (server-side). Without
# it, in-app sync is inert (status reports "hub_not_configured"). Point it at
# the hub's tailnet address. Read by both the server AND the scrypt-sync CLI;
# the server also accepts the legacy bare HUB_URL as a fallback.
# SCRYPT_HUB_URL=http://100.x.y.z:3777
#
# Bearer token sent to the hub for sync writes (falls back to SCRYPT_AUTH_TOKEN
# above; the CLI reads SCRYPT_AUTH_TOKEN).
#
# Bind address. Defaults to 127.0.0.1 (loopback-only). Set it to a routable /
# tailnet IP to expose the server off-box — a token then becomes REQUIRED.
# In Docker this also drives the host publish mapping in docker-compose.
# NOTE: in native (`bun run`) mode the process binds all interfaces regardless
# of this value; it only restricts host exposure under Docker. Run
# `scrypt doctor` to audit actual exposure.
# SCRYPT_BIND_ADDR=127.0.0.1

# Docker only: host directory mounted read-only at /ingest for batch_ingest.
# SCRYPT_INGEST_DIR=./ingest

# Set to production to enforce auth and disable the localhost dev bypass.
# Leave UNSET for native dev (`scrypt init --profile native` comments this out).
# NODE_ENV=production
