# /opt/secrets/shared.env — VPS-wide secrets shared across SUP apps.
#
# Permissions: chmod 600, owned by ubuntu:ubuntu
# Loaded by update-{scrypt,uxie,para-raid} scripts via `source`.
# DO NOT COMMIT real values to git. This file is a TEMPLATE.

# ------------------------------------------------------------------------------
# GHCR pull token — used by update scripts to `docker login` + pull private images.
# ------------------------------------------------------------------------------
# How to issue:
#   1. Open https://github.com/settings/personal-access-tokens/new
#   2. Token name: "VPS GHCR pull (scrypt)"
#   3. Resource owner: psianion
#   4. Repository access: "Only select repositories" → psianion/scrypt
#      (add uxie + para-raid when those repos exist)
#   5. Permissions → Repository permissions:
#        - "Packages" → Read-only
#        - everything else: No access
#   6. Expiration: 90 days
#   7. Generate and paste below.
#
# Rotation: replace before expiry. To revoke: delete from GitHub UI, then
#   ssh para-raid 'docker logout ghcr.io'  # invalidates cached creds
GHCR_USER=psianion
GHCR_PAT=

# ------------------------------------------------------------------------------
# Workflow-dispatch token (optional, only needed if VPS or Uxie should trigger builds).
# ------------------------------------------------------------------------------
# How to issue (separate PAT, NOT the same as above):
#   Same flow as above, but:
#     - Repository access: psianion/scrypt (+ uxie/para-raid later)
#     - Permissions → Repository permissions:
#         - "Actions" → Read and write
#         - "Contents" → Read-only (needed for "Actions: read and write")
#         - "Metadata" → Read-only (auto)
#   Use to call: gh workflow run release.yml -R psianion/scrypt -f version=v1.4.3
#
# WORKFLOW_DISPATCH_PAT=

# ------------------------------------------------------------------------------
# Discord webhook for update-rollback / backup-failure alerts (sup-notify).
# ------------------------------------------------------------------------------
# Discord channel → Edit Channel → Integrations → Webhooks → New Webhook → Copy URL.
# Optional: leave blank to disable notifications entirely.
DISCORD_NOTIFY_WEBHOOK=
