# /opt/secrets/scrypt.env — runtime env loaded by docker-compose.vps.yml.
#
# Permissions: chmod 600, owned by ubuntu:ubuntu
# Loaded via `env_file:` in docker-compose.vps.yml.
# DO NOT COMMIT real values. This file is a TEMPLATE.

# ------------------------------------------------------------------------------
# Production toggle — enables auth gate on /api/* for non-localhost callers.
# ------------------------------------------------------------------------------
NODE_ENV=production

# ------------------------------------------------------------------------------
# Bearer token required by remote callers (MCP, Tailscale peers).
# Generate: openssl rand -hex 32
# Distribute to clients out of band; rotate by editing this file + restarting.
# ------------------------------------------------------------------------------
SCRYPT_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# Vault path inside the container (matches the volume mount in compose).
# ------------------------------------------------------------------------------
SCRYPT_VAULT_PATH=/vault

# ------------------------------------------------------------------------------
# Bind / publish address.
# Drives the host publish mapping in docker-compose.vps.yml
# (${SCRYPT_BIND_ADDR:-127.0.0.1}:3777:3777) AND is read by the app to decide
# the auth posture. Defaults to 127.0.0.1 (localhost-only). Set it to the VPS's
# Tailscale IP (100.x.y.z) so tailnet devices can reach the hub for vault sync.
# A non-loopback value REQUIRES SCRYPT_AUTH_TOKEN above. NEVER set 0.0.0.0
# without a security review.
# ------------------------------------------------------------------------------
# SCRYPT_BIND_ADDR=100.x.y.z

# ------------------------------------------------------------------------------
# Hub URL for IN-APP vault sync (SyncBar / clash-resolver) when THIS instance
# pulls from another hub. Usually unset on the central hub itself. Read by the
# server and the scrypt-sync CLI; the legacy bare HUB_URL is accepted as a
# fallback. Example: http://100.x.y.z:3777
# ------------------------------------------------------------------------------
# SCRYPT_HUB_URL=

# ------------------------------------------------------------------------------
# Embedding worker tuning — defaults are fine for a 2-core VPS. Override only
# if memory pressure or throughput require it.
# ------------------------------------------------------------------------------
# SCRYPT_EMBED_MODEL=Xenova/bge-small-en-v1.5
# SCRYPT_EMBED_BATCH=8
# SCRYPT_EMBED_MAX_TOKENS=450
# SCRYPT_EMBED_OVERLAP=50
# SCRYPT_EMBED_TIMEOUT_MS=300000
# SCRYPT_EMBED_CACHE_DIR=/data/embed-cache

# ------------------------------------------------------------------------------
# Git autocommit — vault snapshots every N seconds. Off by default on VPS;
# Para-RAID handles vault backup at the disk layer.
# ------------------------------------------------------------------------------
# SCRYPT_GIT_AUTOCOMMIT=0
# SCRYPT_GIT_AUTOCOMMIT_INTERVAL=900
